diff --git a/mods/location/test/redis_db_number.unit.test.ts b/mods/location/test/redis_db_number.unit.test.ts
new file mode 100644
index 0000000..f41c083
--- /dev/null
+++ b/mods/location/test/redis_db_number.unit.test.ts
@@ -0,0 +1,22 @@
+import { expect } from "chai"
+import { getRedisUrl } from "../src/redis_store"
+
+describe("Redis logical database selection", () => {
+  it("adds the configured Dragonfly logical database to the Redis URL", () => {
+    const url = getRedisUrl({
+      host: "dragonfly.example.test",
+      port: 6379,
+      username: "default",
+      password: "secret",
+      secure: true,
+      dbNumber: 155
+    })
+
+    expect(url).to.equal("rediss://default:secret@dragonfly.example.test:6379/155")
+  })
+
+  it("preserves Redis database zero when no database is configured", () => {
+    const url = getRedisUrl({ host: "dragonfly.example.test", port: 6379 })
+    expect(url).to.equal("redis://dragonfly.example.test:6379")
+  })
+})
