 static int ws_send_crlf(ws_connection_t *wsc, int opcode);
+
+/* Consume only Home Assistant's exact two-byte LF-only SIP heartbeat after
+ * frame decoding/reassembly. Use the existing application-data CRLF response.
+ */
+static int ws_handle_lf_keepalive(ws_frame_t *frame, char *payload, unsigned int len)
+{
+	if(ws_lf_keepalive_compat != 1
+			|| frame->wsc->sub_protocol != SUB_PROTOCOL_SIP || len != 2
+			|| payload[0] != '\n' || payload[1] != '\n')
+		return 0;
+
+	ws_send_crlf(frame->wsc, OPCODE_TEXT_FRAME);
+	return 1;
+}
 
