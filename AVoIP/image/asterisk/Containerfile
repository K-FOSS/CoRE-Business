# renovate: datasource=docker depName=andrius/asterisk versioning=docker
ARG ASTERISK_BASE=andrius/asterisk:20.20.1-alpine-3.24@sha256:6a016b132caf4c7c4ece59b8e6a6b0fc5564e0a3ebc7a86ea0564be06eab878a

FROM ${ASTERISK_BASE} AS voicemail-module-build

USER root

ARG ASTERISK_SOURCE_SHA256=32ef7db8e449629128eb5f7e42d3d704f03daacb91d76ee694a9acf7f1fd53e2

# The upstream Alpine package does not enable app_voicemail_odbc by default.
# Build that module from the matching Asterisk release with ODBC support.
RUN apk add --no-cache \
      build-base \
      curl \
      jansson-dev \
      libedit-dev \
      libxml2-dev \
      ncurses-dev \
      newt-dev \
      openssl-dev \
      sqlite-dev \
      tar \
      unixodbc-dev \
      util-linux-dev \
      zlib-dev \
    && curl -fsSL 'https://downloads.asterisk.org/pub/telephony/asterisk/releases/asterisk-20.20.1.tar.gz' -o /tmp/asterisk.tar.gz \
    && echo "${ASTERISK_SOURCE_SHA256}  /tmp/asterisk.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/asterisk.tar.gz -C /tmp \
    && cd /tmp/asterisk-20.20.1 \
    && ./configure --with-unixodbc --without-pjproject \
    && make menuselect.makeopts \
    && ./menuselect/menuselect --enable app_voicemail_odbc menuselect.makeopts \
    && make -C apps app_voicemail_odbc.so

FROM ${ASTERISK_BASE}

USER root

ARG ASTERISK_PACKAGE_VERSION=20.20.1-r1
ARG UNIXODBC_PACKAGE_VERSION=2.3.14-r1
ARG PSQLODBC_PACKAGE_VERSION=16.00.0005-r1

# The base image already supplies the ALSA, PostgreSQL, sound, Speex and SRTP
# modules. Add only ODBC support and the PostgreSQL ODBC driver used by
# Asterisk voicemail storage; reinstalling some base packages is blocked by
# the base image's tagged APK repository.
RUN set -eux; \
    apk add --no-cache \
      "asterisk-odbc=${ASTERISK_PACKAGE_VERSION}" \
      "psqlodbc=${PSQLODBC_PACKAGE_VERSION}" \
      "unixodbc=${UNIXODBC_PACKAGE_VERSION}" \
    ; \
    test -x /usr/bin/odbcinst; \
    driver_path="$(find /usr/lib /usr/lib64 -type f -name 'psqlodbcw.so' -print -quit 2>/dev/null)"; \
    if [ -z "$driver_path" ]; then echo 'PostgreSQL Unicode ODBC driver library was not installed'; exit 1; fi; \
    printf '[PostgreSQL Unicode]\nDescription=PostgreSQL Unicode ODBC driver\nDriver=%s\n' "$driver_path" > /tmp/psqlodbc.ini; \
    odbcinst -i -d -f /tmp/psqlodbc.ini; \
    odbcinst -q -d | grep -Fqx '[PostgreSQL Unicode]'; \
    for module in \
         chan_pjsip.so \
         res_pjsip_endpoint_identifier_user.so \
         res_pjsip_endpoint_identifier_ip.so \
         res_pjsip_endpoint_identifier_anonymous.so \
         res_http_media_cache.so \
         cdr_pgsql.so \
         res_odbc.so \
         res_config_odbc.so; do \
         module_path="$(find /usr/lib/asterisk/modules /usr/lib64/asterisk/modules \
           -type f -name "$module" -print -quit 2>/dev/null)"; \
         if [ -z "$module_path" ]; then echo "Missing required Asterisk module: $module"; exit 1; fi; \
       done

COPY --from=voicemail-module-build \
     /tmp/asterisk-20.20.1/apps/app_voicemail_odbc.so \
     /usr/lib/asterisk/modules/app_voicemail_odbc.so

RUN test -s /usr/lib/asterisk/modules/app_voicemail_odbc.so

# The chart replaces the base entrypoint with its runtime credential setup.
# Keep the upstream image's unprivileged runtime identity in effect.
USER 1000:1000
